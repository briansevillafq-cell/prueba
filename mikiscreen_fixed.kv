<MikiScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1  
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "MIK-I"
        size_hint: None, None
        size: 1150, 40
        pos: 0, 620
        color: 0, 0, 0, 1
        canvas.before:
            Color:
                rgba: 0.5, 0.5, 0.5, 1
            Rectangle:
                pos: self.pos
                size: self.size

    FloatLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        FloatLayout:
            id: layout

            Label:
                text: "Pump Control Panel"
                size_hint: None, None
                size: self.texture_size
                pos: 30, 660
                font_size: 22

            # Inputs y etiquetas para cada bomba (0 a 9)

            TextInput:
                id: vol0
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.10, "y": 0.58}

            TextInput:
                id: vol1
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.285, "y": 0.58}

            TextInput:
                id: vol2
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.485, "y": 0.58}

            TextInput:
                id: vol3
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.683, "y": 0.58}

            TextInput:
                id: vol4
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.88, "y": 0.58}

            TextInput:
                id: vol5
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.18, "y": 0.2}

            TextInput:
                id: vol6
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.359, "y": 0.2}

            TextInput:
                id: vol7
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.54, "y": 0.2}

            TextInput:
                id: vol8
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.72, "y": 0.2}

            TextInput:
                id: vol9
                text: "0"
                on_focus: if self.focus: self.text = ""
                multiline: False
                size_hint: None, None
                size: 80, 30
                pos_hint: {"x": 0.90, "y": 0.2}

            # =========================================================
            # BARRA DE CONTROL INFERIOR REAJUSTADA
            # =========================================================

            # --- Botón RESET (Más pequeño) ---
            Button:
                text: "RESET"
                size_hint: None, None
                size: 80, 38
                font_size: 16
                pos_hint: {"x": 0.05, "y": 0.035}
                on_press: root.clr_text()

            # --- ToggleButtons de Modo (In-Order / Parallel más pequeños) ---
            ToggleButton:
                id: inorder
                text: "In-Order"
                group: "modo"
                size_hint: None, None
                size: 75, 35
                pos: 180, 25
                font_size: 13
                bold: True
                background_normal: ""
                background_color: (0.2, 0.6, 0.3, 0.75)
                on_state: root.set_moodWork(self)

            ToggleButton:
                id: parallel
                text: "Parallel"
                group: "modo"
                size_hint: None, None
                size: 75, 35
                pos: 260, 25
                font_size: 13
                bold: True
                background_normal: ""
                background_color: (0.2, 0.6, 0.3, 0.75)
                on_state: root.set_moodWork(self)

            # Sección CheckBox (No / Yes)
            BoxLayout:
                orientation: 'horizontal'
                size_hint: None, None
                size: 100, 50
                pos_hint: {"x": 0.32, "y": 0.03}
                spacing: 2

                BoxLayout:
                    orientation: 'vertical'
                    spacing: 2
                    Label:
                        text: "No"
                        color: 0, 0, 0, 1
                        size_hint_y: 0.4
                        font_size: 12
                    CheckBox:
                        id: checkno
                        group: "options"
                        active: True
                        size_hint_y: 0.6
                        color: (0.5, 0.5, 0.5, 1) if not self.active else (1, 1, 1, 1)
                        on_active: if self.active: root.set_stirringStage(0, True)

                BoxLayout:
                    orientation: 'vertical'
                    spacing: 2
                    Label:
                        text: "Yes"
                        color: 0, 0, 0, 1
                        size_hint_y: 0.4
                        font_size: 12
                    CheckBox:
                        id: checkyes
                        group: "options"
                        size_hint_y: 0.6
                        color: (0.5, 0.5, 0.5, 1) if not self.active else (0.2, 0.6, 1, 1)
                        on_active: if self.active: root.set_stirringStage(1, True)

            # Inputs (Temperatura, RPM, Tiempo)
            TextInput:
                id: temp_input
                text: "0"
                multiline: False
                size_hint: None, None
                size: 65, 30
                pos_hint: {"x": 0.42, "y": 0.04}
                disabled: not checkyes.active

            TextInput:
                id: rpm_input
                text: "0"
                multiline: False
                size_hint: None, None
                size: 65, 30
                pos_hint: {"x": 0.50, "y": 0.04}
                disabled: not checkyes.active

            TextInput:
                id: stir_time
                text: "0"
                multiline: False
                size_hint: None, None
                size: 65, 30
                pos_hint: {"x": 0.58, "y": 0.04}
                disabled: not checkyes.active

            # --- Botón Cam (Gris apagado / Verde encendido) ---
            Button:
                text: "Cam"
                id: camButton
                size_hint: None, None
                size: 75, 45
                font_size: 18
                pos_hint: {"x": 0.66, "y": 0.03}
                background_normal: ""
                background_color: (0.2, 0.7, 0.3, 1) if root.camara_activa else (0.5, 0.5, 0.5, 1)
                on_press: root.toggle_camera()

            # --- Botón START ---
            Button:
                text: "START"
                id: srtButton
                size_hint: None, None
                size: 130, 50
                font_size: 24
                pos_hint: {"x": 0.76, "y": 0.03}
                on_press: root.chyorn()
